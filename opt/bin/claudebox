#!/usr/bin/env python3
"""Run the repository's claudebox package, including through external symlinks."""

import os
import sys
from collections.abc import Callable
from importlib import import_module
from typing import cast

sys.path.insert(
    0, os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "lib")
)

# Hack to dynamically import the main function from claudebox.cli, bypassing static import checks
# yolo
main = cast(Callable[[], None], import_module("claudebox.cli").main)

if __name__ == "__main__":
    main()
