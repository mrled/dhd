# Prepend layers (Containerfile.prepend) build before this file and are passed
# in via CLAUDEBOX_BASE; without one, the default applies.
ARG CLAUDEBOX_BASE=debian:stable-slim
FROM ${CLAUDEBOX_BASE}

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        file \
        git \
        golang \
        gzip \
        iputils-ping \
        jq \
        nftables \
        nodejs \
        procps \
        python3 \
        ruby \
        squid \
        sudo \
        zsh \
    # agent-browser requirements
    && apt-get install -y --no-install-recommends \
        chromium \
        fonts-freefont-ttf \
        fonts-noto-cjk \
        fonts-noto-color-emoji \
        libasound2t64 \
        libatk-bridge2.0-0t64 \
        libatk1.0-0t64 \
        libatspi2.0-0 \
        libcairo-gobject2 \
        libcairo2 \
        libdbus-1-3 \
        libdrm2 \
        libcups2t64 \
        libfontconfig1 \
        libfreetype6 \
        libgbm1 \
        libgdk-pixbuf-2.0-0 \
        libgtk-3-0t64 \
        libnspr4 \
        libnss3 \
        libnss3-tools \
        libpango-1.0-0 \
        libpangocairo-1.0-0 \
        libx11-6 \
        libx11-xcb1 \
        libxcomposite1 \
        libxcursor1 \
        libxdamage1 \
        libxext6 \
        libxfixes3 \
        libxi6 \
        libxkbcommon0 \
        libxrandr2 \
        libxrender1 \
        libxcb-shm0 \
        libxcb1 \
        libxshmfence1 \
    && rm -rf /var/lib/apt/lists/*

ARG HUGO_VERSION=0.164.0
RUN if command -v hugo >/dev/null; then \
        hugo version; \
    else \
        arch="$(dpkg --print-architecture)" \
        && curl -fsSL "https://github.com/gohugoio/hugo/releases/download/v${HUGO_VERSION}/hugo_extended_${HUGO_VERSION}_linux-${arch}.tar.gz" \
        | tar -xz -C /usr/local/bin hugo; \
    fi

COPY --chmod=0755 entrypoint.sh /usr/local/bin/claudebox-entrypoint
COPY netblocked /usr/local/bin/netblocked
COPY apt-install /usr/local/bin/apt-install
COPY CLAUDE.container.md /etc/claude-code/CLAUDE.md
COPY squid.conf netwhitelist-default.txt /etc/claudebox/

RUN useradd -m -u 1000 -s /bin/zsh claude \
    && mkdir -p /home/linuxbrew \
    && chown claude:claude /home/linuxbrew \
    && echo 'claude ALL=(root) NOPASSWD: /usr/local/bin/apt-install' > /etc/sudoers.d/claudebox-apt-install \
    && chmod 440 /etc/sudoers.d/claudebox-apt-install

USER claude

ENV HOMEBREW_PREFIX=/home/linuxbrew/.linuxbrew
ENV PATH="$HOMEBREW_PREFIX/bin:$HOMEBREW_PREFIX/sbin:$PATH"
ENV AGENT_BROWSER_EXECUTABLE_PATH=/usr/bin/chromium

RUN NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"

# Paseo is installed as a normal CLI in the claudebox image rather than making
# its Docker image our base. Nothing starts it automatically; claudebox2's
# explicit `run paseo` mode invokes the non-root guard below. Paseo's own image
# currently uses Node 22, so keep that runtime versioned instead of relying on
# Debian's older nodejs package.
ARG PASEO_VERSION=0.4.0
RUN brew install node@22 \
    && brew link --force --overwrite node@22 \
    && npm install --global "@getpaseo/cli@${PASEO_VERSION}"

COPY --chmod=0755 paseo-nonroot /usr/local/bin/claudebox-paseo

# Bump CLAUDEBOX_AI_CACHEBUST (via `claudebox2 build --aiupdate`) to force this
# layer to rebuild and reinstall the AI agents without busting the whole cache.
# The value is referenced in the RUN so a change reliably invalidates its cache.
ARG CLAUDEBOX_AI_CACHEBUST=0
RUN echo "ai cachebust: ${CLAUDEBOX_AI_CACHEBUST}" \
    && brew install --cask claude-code codex \
    && npm install --global --ignore-scripts @earendil-works/pi-coding-agent \
    && npm install --global agent-browser

WORKDIR /src

ENTRYPOINT ["/usr/local/bin/claudebox-entrypoint"]
