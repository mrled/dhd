# Additional domains allowed when restricted networking is enabled.
# Built-in AI and package endpoints are allowed automatically.
# 'host.com' matches exactly; '.host.com' also matches subdomains.

# example.com
# .example.org
# Docker/Podman hostports.txt allows host.docker.internal and
# host.containers.internal ONLY on its ports via Squid in either mode.
# Hostports alone does not restrict public domains; this file does.
